# Local data directory. For Render, mount a persistent disk at /var/data and set this to /var/data.
OMNIFORENSICS_DATA_DIR=./data
# Optional explicit database path (e.g. /var/data/omni.sqlite)
OMNIFORENSICS_DB_PATH=
OMNIFORENSICS_MAX_UPLOAD_MB=100
OMNIFORENSICS_ENABLE_OCR=false
OMNIFORENSICS_YOLO_MODEL=

# Set true for any internet-facing deployment. Configure username/password in the hosting dashboard.
OMNIFORENSICS_PUBLIC_MODE=false
OMNIFORENSICS_USERNAME=
OMNIFORENSICS_PASSWORD=

# Comma-separated exact browser origins allowed to call the API (no paths).
OMNIFORENSICS_CORS_ORIGINS=https://codex-inn.github.io,http://localhost:8000,http://127.0.0.1:8000
