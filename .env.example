# Optional environment settings for the stateless FastAPI API.
# The GitHub Pages browser-only edition does not read this file or need a backend.
OMNIFORENSICS_MAX_FILE_MB=4
OMNIFORENSICS_CORS_ORIGINS=https://codex-inn.github.io,http://localhost:8000,http://127.0.0.1:8000

# If exposing the optional API publicly, enable authentication and set unique credentials.
OMNIFORENSICS_PUBLIC_MODE=true
OMNIFORENSICS_USERNAME=replace-with-a-unique-username
OMNIFORENSICS_PASSWORD=replace-with-a-long-random-password

# Hosting logs/operational metadata may still exist even though case files are not persisted by the API.
